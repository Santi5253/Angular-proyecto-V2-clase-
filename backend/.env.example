# Copia este archivo como .env (nunca subas el .env a GitHub)
PORT=3000

# --- Opción A: Railway (o cualquier Postgres en la nube) ---
# Si existe DATABASE_URL, el backend usa solo esta variable.
# DATABASE_URL=postgresql://usuario:clave@host:5432/base

# --- Opción B: PostgreSQL local ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=caja_user
DB_PASSWORD=caja123
DB_NAME=caja_clase_v2

# Superusuario local, solo para "npm run db:init"
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=

# URL(s) del frontend permitidas por CORS, separadas por coma
FRONT_URL=http://localhost:4200
